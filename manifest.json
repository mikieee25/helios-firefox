{
  "manifest_version": 3,
  "name": "Helios Download Bridge",
  "description": "Send browser downloads to the Helios desktop app.",
  "version": "0.1.1",
  "icons": {
    "32": "helios-32.png",
    "64": "helios-64.png",
    "128": "helios-128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "cookies",
    "contextMenus",
    "notifications",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Helios",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "helios-32.png",
      "64": "helios-64.png",
      "128": "helios-128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": {
      "id": "helios-firefox@mikieee25.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteActivity"],
        "optional": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
